<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="volto.formsupport.dataexport">

  <!-- REST API endpoint: POST @form-export-api -->
  <plone:service
      method="POST"
      factory=".form_export_api.post.FormExportApiPost"
      for="*"
      name="@form-export-api"
      permission="zope2.View"
      />

</configure>
